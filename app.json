{
  "expo": {
    "name": "Momo",
    "slug": "momo",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.momo.companion",
      "infoPlist": {
        "NSCameraUsageDescription": "用于拍摄饮食照片，帮你快速记录这一餐。",
        "NSPhotoLibraryUsageDescription": "用于选择饮食照片，帮你快速记录这一餐。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "允许 Momo 读取饮食照片，用于识别和记录这一餐。",
          "cameraPermission": "允许 Momo 拍摄饮食照片，用于识别和记录这一餐。"
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
